{
    "name": "qstom-doo/minimax-php",
    "description": "Client for the Minimax accounting API (moj.minimax.si): customers, issued invoices, PDFs and code lists.",
    "type": "library",
    "license": "MIT",
    "keywords": ["minimax", "invoices", "accounting", "laravel"],
    "require": {
        "php": "^8.3",
        "illuminate/http": "^12.0|^13.0",
        "illuminate/contracts": "^12.0|^13.0",
        "illuminate/support": "^12.0|^13.0"
    },
    "require-dev": {
        "pestphp/pest": "^4.0|^5.0",
        "laravel/pint": "^1.20"
    },
    "autoload": {
        "psr-4": {
            "Qstom\\Minimax\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Qstom\\Minimax\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "pest",
        "format": "pint"
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
